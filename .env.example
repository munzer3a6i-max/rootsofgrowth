# ── Contact form ─────────────────────────────────────────────────────────────
# Default: FormSubmit (formsubmit.co) delivers submissions to info@rootsofgrowth.com.sa
# with no setup. The FIRST submission sends an "Activate Form" email to that inbox —
# click it once. Optional: after activating, paste the random alias FormSubmit gives
# you here to keep the address out of the page source.
NEXT_PUBLIC_FORMSUBMIT_ID=
# Set to "smtp" to use the built-in /api/contact route with the SMTP_* settings below.
NEXT_PUBLIC_CONTACT_MODE=

# SMTP settings used by the contact form (/api/contact).
# With Hostinger email: host smtp.hostinger.com, port 465, secure true.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@rootsofgrowth.com.sa
SMTP_PASS=your-mailbox-password
# Where contact form submissions are delivered (comma-separated for several).
# Optional: defaults to info@rootsofgrowth.com.sa
CONTACT_TO=info@rootsofgrowth.com.sa
# Optional: the "From" address (defaults to SMTP_USER)
CONTACT_FROM=
# Public site URL, used for metadata / sitemap
NEXT_PUBLIC_SITE_URL=https://rootsofgrowth.com
