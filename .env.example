# SMTP settings used by the contact form (/api/contact).
# With Hostinger email: host smtp.hostinger.com, port 465, secure true.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@rootsofgrowth.com.sa
SMTP_PASS=your-mailbox-password
# Where contact form submissions are delivered (comma-separated for several).
# Optional: defaults to info@rootsofgrowth.com.sa
CONTACT_TO=info@rootsofgrowth.com.sa
# Optional: the "From" address (defaults to SMTP_USER)
CONTACT_FROM=
# Public site URL, used for metadata / sitemap
NEXT_PUBLIC_SITE_URL=https://rootsofgrowth.com
